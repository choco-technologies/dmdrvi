# DMOD Resource File for dmdrvi
# This file specifies where resources should be installed

# === Core Module ===
# Main module file - always installed
dmf=./dmdrvi.dmf => ${destination}/${module}.dmf [origin=${dmf_dir}/dmdrvi.dmf]

# Compressed module
dmfc=./dmdrvi.dmfc => ${destination}/${module}.dmfc [origin=${build_dir}/dmfc/dmdrvi.dmfc]

# Dependencies file (if exists)
dmd=./dmdrvi.dmd => ${destination}/${module}.dmd [origin=${dmf_dir}/dmdrvi.dmd]

# Version information
version=./dmdrvi_version.txt => ${destination}/${module}_version.txt [origin=${dmf_dir}/dmdrvi_version.txt]

# === Documentation ===
# Module documentation in markdown format for dmf-man tool
docs=./docs => ${destination}/${module}/docs [origin=${repo_dir}/docs]

# README file
readme=./README.md => ${destination}/${module}/README.md [origin=${repo_dir}/README.md]

# === Header Files ===
# Include directory with all headers (dmdrvi.h and dmdrvi_defs.h)
inc=./include => ${destination}/${module}/include [origin=${repo_dir}/include] [origin=${build_dir}/dmdrvi_defs.h]

# === License ===
# License file
license=./LICENSE => ${destination}/${module}/LICENSE [origin=${repo_dir}/LICENSE]

dmr=./dmdrvi.dmr => ${destination}/${module}/dmdrvi.dmr [origin=${repo_dir}/dmdrvi.dmr]
